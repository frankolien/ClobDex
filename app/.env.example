# Shape only. Copy to `.env.local`, which is gitignored.
#
# `npm run dev` works without this file: every setting below falls back to where this
# repository's own tooling runs — the local indexer, the local marketing site, the devnet
# program this repo deploys. A production build has no fallbacks and throws on the first
# one that is missing, because a shipped bundle pointing somewhere plausible and wrong is
# the failure this arrangement exists to prevent.
#
# Everything here is baked into the bundle at build time and served to anyone who loads
# the page, so none of it can be a secret. An RPC endpoint with a key in the URL is a key
# you have published — use a public endpoint here, or one whose access is restricted by
# referrer rather than by secrecy.

# A clob-stream instance. The WebSocket URL is derived from this, so there is one host to
# set and no way to point the feed and the snapshots at different instances.
VITE_INDEXER_URL=http://localhost:8080

# The deployed program.
VITE_PROGRAM_ADDRESS=DaNh1GkExAEmfJ2TzKaSDPckq47uwYuDzL9aeGU9fiqK

# Where signed transactions go.
VITE_RPC_URL=https://api.devnet.solana.com

# devnet | mainnet | localnet. Drives the badge in the header; unset means devnet, so a
# misconfigured deploy fails towards the network where a mistake costs nothing.
VITE_CLUSTER=devnet

# The marketing site. A separate deploy, so this is a URL rather than a route.
VITE_SITE_URL=https://example.com
