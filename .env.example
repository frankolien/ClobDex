# Copy to .env and fill in. .env is gitignored; this file is not — so never put a
# real token here.

# HTTP JSON-RPC endpoint, used by clob-cli.
RPC_URL=

# Helius LaserStream — a Yellowstone-compatible gRPC endpoint.
# Endpoint encodes both network and region, e.g.
#   https://laserstream-devnet-ewr.helius-rpc.com
LASERSTREAM_ENDPOINT=
# Sent as the x-token gRPC metadata header. Same value as the Helius API key.
LASERSTREAM_TOKEN=

# Deployed program id to subscribe to.
CLOB_PROGRAM_ID=

# confirmed indexes ~1s sooner but can be rolled back; finalized cannot.
COMMITMENT=confirmed

# Comma-separated origins allowed to read the API from a browser. Unset means any, which is
# correct for public read-only market data — see the crate README before changing it.
ALLOWED_ORIGINS=
