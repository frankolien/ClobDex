{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    // Node runs TypeScript directly by stripping types, and its resolver does not guess
    // extensions — so imports have to name the `.ts` file that actually exists. These two
    // let tsc accept that and rewrite it to `.js` when it emits, so one set of imports
    // works both for `node --test` and for a built package.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    // Node strips types rather than compiling them, so anything that would emit runtime
    // code — an enum, a namespace, a parameter property — cannot run. Enforcing it here
    // means the type checker says so, instead of the test runner discovering it.
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
