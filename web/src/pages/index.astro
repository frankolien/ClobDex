---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import HowItWorks from "../components/HowItWorks.astro";
import LiveBook from "../components/LiveBook.astro";
import Classes from "../components/Classes.astro";
import Compute from "../components/Compute.astro";
import Developers from "../components/Developers.astro";
import Stack from "../components/Stack.astro";
import Status from "../components/Status.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
---

<Base
  title="ClobDex — the onchain order book that settles in one go"
  description="A crankless central limit order book on Solana. Post, cancel and fill in a single transaction, with no crank, no oracle and no custody. A market maker refreshes an entire two-sided ladder for 4,639 compute units."
>
  <Hero />
  <Marquee />
  <HowItWorks />
  <LiveBook />
  <Classes />
  <Compute />
  <Developers />
  <Stack />
  <Status />
  <Faq />
  <Closing />
</Base>
