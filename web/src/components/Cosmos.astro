---
/**
 * The starfield.
 *
 * The reference's fourth beat: a wide, quiet, cosmic moment between two dense sections.
 * It earns its place by being the one part of the page you can push on — three depth
 * layers that lean towards the pointer by different amounts, which is what reads as
 * distance rather than as a texture sliding about.
 */
---

<section class="band" id="cosmos">
  <canvas id="sky" aria-hidden="true"></canvas>

  <div class="shell inner">
    <p class="eyebrow reveal">A new slot every 400 milliseconds</p>
    <h2 class="reveal" style="--delay:80ms">
      A trade can be taken back.<br />Ours says so.
    </h2>
    <p class="lede reveal" style="--delay:160ms">
      Indexing at <em>confirmed</em> sees a fill about a second before finality does, and
      accepts that the slot carrying it can still be abandoned. Most feeds quietly keep the
      trade. This one pushes a retraction, because volume that did not happen is the number
      a venue is most tempted to get wrong.
    </p>

    <div class="stat-row reveal" style="--delay:240ms">
      <div class="stat">
        <span class="num v data">501</span>
        <span class="l">tests</span>
      </div>
      <div class="stat">
        <span class="num v data">13</span>
        <span class="l">instructions</span>
      </div>
      <div class="stat">
        <span class="num v data">0</span>
        <span class="l">oracles</span>
      </div>
      <div class="stat">
        <span class="num v data">0</span>
        <span class="l">cranks</span>
      </div>
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(120% 80% at 50% 120%, rgb(71 69 107 / 0.55) 0%, rgb(4 5 10 / 0) 60%),
      linear-gradient(180deg, var(--ink-2) 0%, #0a0f22 45%, var(--ink-2) 100%);
  }

  #sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: -1;
  }

  .inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  h2 {
    font-size: clamp(2rem, 5.4vw, 4rem);
  }

  .lede {
    max-width: 56ch;
  }

  .lede em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.92em;
    color: var(--ice);
  }

  .stat-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin-top: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    width: min(100%, 44rem);
  }

  .stat {
    display: grid;
    gap: 0.2rem;
  }

  .v {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .l {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
</style>

<script>
  import { ease, pointerTarget, viewProgress } from "../scripts/pointer.ts";

  type Star = { x: number; y: number; r: number; a: number; phase: number };
  type Layer = { stars: Star[]; depth: number };

  /** Stars per layer, nearest last. Far layers are dense and dim; near ones are sparse. */
  const DENSITY = [220, 90, 34];

  /** How far each layer leans, as a fraction of the canvas. Distance is the whole effect. */
  const LEAN = [0.006, 0.018, 0.042];

  const canvas = document.getElementById("sky") as HTMLCanvasElement | null;
  const band = document.getElementById("cosmos");
  const context = canvas?.getContext("2d", { alpha: true }) ?? null;

  if (canvas && band && context) {
    // Seeded, so the constellation is the same on every load. A sky that rearranges
    // itself between visits is a sky nobody can compose a headline against.
    let seed = 0x2545f491;
    const random = () => {
      seed ^= seed << 13;
      seed ^= seed >>> 17;
      seed ^= seed << 5;
      return ((seed >>> 0) % 100000) / 100000;
    };

    const layers: Layer[] = DENSITY.map((count, index) => ({
      depth: index,
      stars: Array.from({ length: count }, () => ({
        x: random(),
        y: random(),
        r: 0.4 + index * 0.5 + random() * (0.5 + index * 0.6),
        a: 0.25 + index * 0.16 + random() * 0.45,
        phase: random() * Math.PI * 2,
      })),
    }));

    // The band of light. Three soft ellipses rather than a texture, so it costs nothing
    // and scales to any viewport.
    const clouds = Array.from({ length: 3 }, () => ({
      x: 0.2 + random() * 0.6,
      y: 0.25 + random() * 0.5,
      rx: 0.35 + random() * 0.4,
      ry: 0.12 + random() * 0.16,
      hue: 205 + random() * 60,
    }));

    let shooting: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
    let nextShot = 2 + random() * 5;

    let width = 0;
    let height = 0;
    const lean = { x: 0, y: 0 };

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const box = canvas.getBoundingClientRect();
      width = box.width;
      height = box.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    const draw = (seconds: number, delta: number) => {
      const pointer = pointerTarget();
      // Eased towards the pointer rather than pinned to it: a sky that tracks exactly is a
      // sky glued to the cursor, and the lag is what makes it feel far away.
      lean.x = ease(lean.x, pointer.x, 0.045);
      lean.y = ease(lean.y, pointer.y, 0.045);

      // Scroll contributes a slow vertical drift on top of the pointer, so the section
      // still has depth on a touch device that never reports a pointer at all.
      const scroll = (viewProgress(band) - 0.5) * 2;

      context.clearRect(0, 0, width, height);

      for (const cloud of clouds) {
        const glow = context.createRadialGradient(
          (cloud.x + lean.x * 0.01) * width,
          (cloud.y + scroll * 0.03) * height,
          0,
          (cloud.x + lean.x * 0.01) * width,
          (cloud.y + scroll * 0.03) * height,
          cloud.rx * width,
        );
        glow.addColorStop(0, `hsl(${cloud.hue} 70% 60% / 0.09)`);
        glow.addColorStop(1, `hsl(${cloud.hue} 70% 60% / 0)`);
        context.fillStyle = glow;
        context.save();
        context.translate((cloud.x + lean.x * 0.01) * width, (cloud.y + scroll * 0.03) * height);
        context.scale(1, cloud.ry / cloud.rx);
        context.translate(-(cloud.x + lean.x * 0.01) * width, -(cloud.y + scroll * 0.03) * height);
        context.fillRect(0, 0, width, height);
        context.restore();
      }

      for (const layer of layers) {
        const shift = LEAN[layer.depth] ?? 0;
        const offsetX = lean.x * shift * width;
        const offsetY = lean.y * shift * height + scroll * shift * height * 3;

        for (const star of layer.stars) {
          // Twinkle is per-star and slow. Layers at the same rate look like a flicker.
          const twinkle = 0.72 + Math.sin(seconds * 0.9 + star.phase) * 0.28;
          context.beginPath();
          context.arc(
            star.x * width + offsetX,
            star.y * height + offsetY,
            star.r,
            0,
            Math.PI * 2,
          );
          context.fillStyle = `rgba(226, 240, 255, ${star.a * twinkle})`;
          context.fill();
        }
      }

      nextShot -= delta;
      if (nextShot <= 0 && !shooting) {
        shooting = {
          x: random() * 0.7,
          y: random() * 0.4,
          vx: 0.34 + random() * 0.22,
          vy: 0.14 + random() * 0.1,
          life: 1,
        };
        nextShot = 4 + random() * 9;
      }

      if (shooting) {
        shooting.x += shooting.vx * delta;
        shooting.y += shooting.vy * delta;
        shooting.life -= delta * 0.7;

        if (shooting.life <= 0) {
          shooting = null;
        } else {
          const headX = shooting.x * width;
          const headY = shooting.y * height;
          const tailX = headX - shooting.vx * width * 0.13;
          const tailY = headY - shooting.vy * height * 0.13;

          const streak = context.createLinearGradient(tailX, tailY, headX, headY);
          streak.addColorStop(0, "rgba(226, 240, 255, 0)");
          streak.addColorStop(1, `rgba(226, 240, 255, ${shooting.life * 0.85})`);
          context.strokeStyle = streak;
          context.lineWidth = 1.4;
          context.lineCap = "round";
          context.beginPath();
          context.moveTo(tailX, tailY);
          context.lineTo(headX, headY);
          context.stroke();
        }
      }
    };

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;
    let running = false;
    let last = 0;

    const loop = (timestamp: number) => {
      const seconds = timestamp / 1000;
      const delta = last === 0 ? 0 : Math.min(0.05, seconds - last);
      last = seconds;
      draw(seconds, delta);
      frame = requestAnimationFrame(loop);
    };

    const start = () => {
      if (running || reduced.matches) return;
      running = true;
      last = 0;
      frame = requestAnimationFrame(loop);
    };

    const stop = () => {
      running = false;
      cancelAnimationFrame(frame);
    };

    const visible = new IntersectionObserver(
      ([entry]) => (entry?.isIntersecting ? start() : stop()),
      { threshold: 0 },
    );
    visible.observe(canvas);

    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));

    const settle = () => {
      resize();
      if (reduced.matches) {
        stop();
        // Still a sky, just a still one. A black rectangle where the design was is worse
        // than no motion.
        draw(0, 0);
      } else {
        start();
      }
    };

    reduced.addEventListener("change", settle);
    window.addEventListener("resize", settle, { passive: true });
    settle();
  }
</script>
