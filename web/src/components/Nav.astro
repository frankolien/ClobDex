---
import { links } from "../site.ts";
---

<header class="bar">
  <nav class="pill" aria-label="Primary">
    <a class="item" href="#how">Protocol</a>
    <a class="item" href="#compute">Compute</a>

    <a class="mark" href="/" aria-label="ClobDex home">
      <svg viewBox="0 0 32 32" width="18" height="18" aria-hidden="true">
        <path d="M9 20h4v4H9zM9 14h4v4H9zM15 8h4v4h-4zM21 14h4v4h-4z" fill="currentColor"></path>
      </svg>
    </a>

    <a class="item" href="#stack">Stack</a>
    <a class="item" href={links.github} rel="noopener">GitHub</a>
  </nav>

  <!-- A different origin, not a route. The app is its own deploy, so this is the one
       place the boundary between the two is crossed. -->
  <a class="btn btn-primary launch" href={links.app}>
    Launch app
    <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
      <path
        d="M4 12L12 4M12 4H6M12 4v6"
        stroke="currentColor"
        stroke-width="1.6"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>
</header>

<style>
  .bar {
    position: fixed;
    inset: 1rem 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding-inline: 1.5rem;
    pointer-events: none;
  }

  .bar > * {
    pointer-events: auto;
  }

  .pill,
  .launch {
    /* The glass the reference leans on. `saturate` matters more than the blur: it keeps
       the colour of whatever is behind from going grey as it is blurred. */
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(10 14 24 / 0.6);
  }

  .item {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--text-2);
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .item:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }

  .mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-inline: 0.15rem;
    border-radius: 999px;
    background: var(--data);
    color: var(--ink);
    transition: box-shadow 0.3s var(--ease);
  }

  .mark:hover {
    box-shadow: 0 0 24px -4px var(--data);
  }

  .launch {
    background: rgb(242 245 251 / 0.94);
  }

  @media (max-width: 720px) {
    .item {
      display: none;
    }

    .bar {
      justify-content: space-between;
    }
  }
</style>
