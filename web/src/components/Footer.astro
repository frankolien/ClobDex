---
import { links, status } from "../site.ts";

/**
 * The reference closes with a block of disclosures. Kept, and the text is real rather than
 * boilerplate: this is unaudited software on a test network, and the page above is
 * persuasive enough that the last thing on it should say so plainly.
 */
const columns = [
  {
    title: "Protocol",
    items: [
      { name: "How it settles", href: "#how" },
      { name: "Market classes", href: "#classes" },
      { name: "Compute", href: "#compute" },
      { name: "Status", href: "#status" },
    ],
  },
  {
    title: "Developers",
    items: [
      { name: "GitHub", href: links.github },
      { name: "TypeScript SDK", href: links.sdk },
      { name: "Indexer", href: links.indexer },
      { name: "Benchmarks", href: links.benchmarks },
    ],
  },
];
---

<footer>
  <div class="shell top">
    <div class="brand">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <rect width="24" height="24" rx="6" fill="var(--green)"></rect>
        <path d="M6 15h3v3H6zM6 10h3v3H6zM10.5 6h3v3h-3zM15 10h3v3h-3z" fill="#050607"></path>
      </svg>
      <span>ClobDex</span>
    </div>

    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="ct">{column.title}</p>
          {column.items.map((item) => (
            <a href={item.href} rel="noopener">{item.name}</a>
          ))}
        </nav>
      ))
    }

    <div class="cta">
      <p class="ct">Trading app</p>
      <a class="btn btn-line" href={links.app}>Launch app</a>
    </div>
  </div>

  <div class="shell disclosure">
    <p class="dt">Important notes about ClobDex.</p>
    <p>
      ClobDex is unaudited software deployed on Solana {status.cluster.toLowerCase()}. It has
      not been reviewed by a security firm and is not deployed to mainnet. Nothing on this
      site is financial advice, an offer, or a solicitation, and none of it should be read as
      a promise that any particular version will ever ship.
    </p>
    <p>
      Every performance figure quoted is compute consumed by the program, measured against
      the compiled binary and reproducible from the repository. Compute is not latency,
      throughput, or price improvement, and it excludes the per-signature and per-account
      costs that no venue controls. No comparison against another venue is claimed anywhere,
      because none has been measured.
    </p>
    <p>
      The order book shown on this page is generated by a random walk and is labelled as
      such. It is an illustration of the interface, not a record of anything that traded.
    </p>
    <p class="fine">
      Program <span class="num">{status.programAddress}</span> · MIT licensed · ©{" "}
      {new Date().getFullYear()} ClobDex
    </p>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    border-top: 1px solid var(--line);
  }

  .top {
    display: grid;
    grid-template-columns: 1.4fr repeat(2, 1fr) 1fr;
    gap: 2rem;
    padding-block: 3.5rem 3rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    align-self: start;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  nav,
  .cta {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .ct {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-4);
    margin-bottom: 0.2rem;
  }

  nav a {
    font-size: 0.875rem;
    color: var(--text-2);
    transition: color 0.18s var(--ease);
  }

  nav a:hover {
    color: var(--text);
  }

  .cta .btn {
    justify-self: start;
    padding: 0.5em 1.1em;
    font-size: 0.875rem;
  }

  .disclosure {
    display: grid;
    gap: 0.9rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--line);
    font-size: 0.78125rem;
    line-height: 1.65;
    color: var(--text-4);
    max-width: min(72rem, 100% - 3rem);
  }

  .dt {
    color: var(--text-2);
    font-weight: 500;
  }

  .fine {
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
    word-break: break-word;
  }

  @media (max-width: 860px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
