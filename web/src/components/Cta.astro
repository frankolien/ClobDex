---
import { links, status } from "../site.ts";
---

<section class="band">
  <div class="shell inner">
    <h2 class="reveal">Open the book.</h2>
    <p class="lede reveal" style="--delay:80ms">
      The app is a separate deploy running against {status.cluster.toLowerCase()}. Claim a
      seat, deposit test tokens, and watch a fill settle inside the transaction that caused
      it.
    </p>

    <div class="actions reveal" style="--delay:160ms">
      <a class="btn btn-dark" href={links.app}>Launch app</a>
      <a class="btn btn-outline" href={links.github} rel="noopener">Read the source</a>
    </div>
  </div>
</section>

<style>
  /* The end of the journey: night at the top of the page, full daylight here. */
  .band {
    background: linear-gradient(180deg, var(--dawn-3) 0%, var(--dawn-4) 100%);
    color: var(--ink);
    text-align: center;
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }

  h2 {
    font-size: clamp(2.4rem, 6vw, 4.25rem);
  }

  .lede {
    color: rgb(4 5 10 / 0.72);
    max-width: 48ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .btn-dark {
    background: var(--ink);
    color: var(--text);
  }

  .btn-dark:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 34px -12px rgb(4 5 10 / 0.7);
  }

  .btn-outline {
    border-color: rgb(4 5 10 / 0.28);
    color: var(--ink);
  }

  .btn-outline:hover {
    border-color: rgb(4 5 10 / 0.55);
    background: rgb(4 5 10 / 0.05);
  }
</style>
