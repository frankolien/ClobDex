# Unanchored, so it matches every workspace's build output and not just the root's.
# clob-cli, clob-ops and clob-stream are separate workspaces, each with its own target.
target/
**/*.rs.bk
.DS_Store

# Endpoint credentials. Only .env.example is tracked.
.env
.env.*
!.env.example

# Markets created by clob-cli, including mint keypairs.
.clob/
