# Unanchored, so it matches every workspace's build output and not just the root's.
# The off-chain tools are separate workspaces, each with its own target directory.
target/
**/*.rs.bk
.DS_Store

# Endpoint credentials. Only .env.example is tracked.
.env
.env.*
!.env.example

# Markets created by clob-cli, including mint keypairs.
.clob/

# Node dependencies and build output. Unanchored for the same reason as `target/`: the
# SDK, the app and the marketing site are separate packages with separate deploys, and
# each produces its own.
node_modules/
dist/
.astro/
